# Clave de API de Google Gemini (Obtén una gratis en https://aistudio.google.com/apikey)
# En Vercel: agrégala en Project Settings -> Environment Variables como GEMINI_API_KEY
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Límite de peticiones por minuto por IP (por defecto: 15)
RATE_LIMIT_PER_MINUTE=15
